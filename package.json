{
  "name": "motion-design-library",
  "version": "1.0.0",
  "description": "Biblioteca de motion design responsiva em Remotion: 9:16, 16:9 e 1:1 com o mesmo código",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "@remotion/media": "4.0.544",
    "@remotion/transitions": "4.0.544",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.544",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:vertical": "remotion render Vertical-9x16 out/vertical-9x16.mp4",
    "render:horizontal": "remotion render Horizontal-16x9 out/horizontal-16x9.mp4",
    "render:quadrado": "remotion render Quadrado-1x1 out/quadrado-1x1.mp4",
    "nova-producao": "node scripts/nova-producao.mjs",
    "catalogo": "tsx scripts/catalogo.ts",
    "validar": "eslint src && tsc && tsx scripts/catalogo.ts --validar",
    "trilha-demo": "python3 scripts/gerar-trilha.py",
    "analisar-referencia": "python3 scripts/analisar-referencia.py",
    "fotos": "python3 scripts/fotos-drive.py",
    "alinhar-letra": "python3 scripts/alinhar-letra.py"
  },
  "allowScripts": {
    "esbuild": false
  }
}
