  "narracao": [
    {
      "id": "N1",
      "inicio": 6.5,
      "fim": 12.36,
      "origem": [11.64, 17.5],
      "texto": "Na arte, na ciência e na história, sempre buscamos representar aquilo que transcende a nossa compreensão."
    },
    {
      "id": "N2a",
      "inicio": 14.45,
      "fim": 19.85,
      "origem": [23.36, 28.76],
      "texto": "Mas, entre os dedos que quase se tocam, existe a representação de algo muito maior."
    },
    {
      "id": "N2b",
      "inicio": 20.75,
      "fim": 22.97,
      "origem": [29.32, 31.54],
      "texto": "A relação entre Deus e a humanidade."
    },
    {
      "id": "N3",
      "inicio": 24.25,
      "fim": 26.95,
      "origem": [32.08, 34.78],
      "texto": "Uma relação que, em algum momento, foi interrompida."
    },
    {
      "id": "N4",
      "inicio": 28.05,
      "fim": 31.39,
      "origem": [40.34, 43.68],
      "texto": "Mas Deus nunca deixou de nos convidar ao retorno."
    },
    {
      "id": "N5",
      "inicio": 31.45,
      "fim": 34.15,
      "origem": [44.16, 46.86],
      "texto": "O Senhor continua chamando uma geração."
    },
    {
      "id": "N6a",
      "inicio": 34.25,
      "fim": 36.89,
      "origem": [57.92, 60.56],
      "texto": "Não é sobre aparências, mas sobre entrega."
    },
    {
      "id": "N6b",
      "inicio": 37.95,
      "fim": 39.91,
      "origem": [60.98, 62.94],
      "texto": "Não é sobre conveniência, mas sobre renúncia."
    },
    {
      "id": "N7a",
      "inicio": 41.05,
      "fim": 42.97,
      "origem": [80.58, 82.5],
      "texto": "É tempo de voltar."
    },
    {
      "id": "N7b",
      "inicio": 43.05,
      "fim": 44.15,
      "origem": [83.52, 84.62],
      "texto": "É tempo de reconhecer."
